# Offline migration path for an explicitly trusted, locally available MDD predecessor image.
# It refreshes all runtime-owned files without contacting a registry or rebuilding Asterisk.
ARG BASE_IMAGE=onewifi/engine-base:trusted
FROM ${BASE_IMAGE}

COPY pin_keeper.py   /usr/local/bin/pin_keeper.py
COPY ami_usim.py     /usr/local/bin/ami_usim.py
COPY swu_ike.py      /usr/local/bin/swu_ike.py
COPY outer_transport.py /usr/local/bin/outer_transport.py
COPY log_capture.py  /usr/local/bin/log_capture.py
COPY render.py       /usr/local/bin/render.py
COPY notify.py       /usr/local/bin/notify.py
COPY templates/      /opt/onewifi/templates/
COPY entrypoint.sh   /entrypoint.sh
RUN chmod +x /usr/local/bin/*.py /entrypoint.sh

# Fingerprints of what went into this image, so a later reload can tell whether the change it
# is carrying needs a full rebuild (Asterisk-level inputs) or only this overlay (scripts).
ARG RUNTIME_FP=""
ARG BASE_FP=""
ARG ONEWIFI_VERSION=""
LABEL io.onewifi.managed="true" \
      io.onewifi.egress-transports="socks5" \
      io.onewifi.runtime-fp="${RUNTIME_FP}" \
      io.onewifi.base-fp="${BASE_FP}" \
      org.opencontainers.image.version="${ONEWIFI_VERSION}" \
      org.opencontainers.image.source="https://github.com/OneCatx/OneWIFIX" \
      org.opencontainers.image.title="MDD Sim Gateway VoWiFi engine"
ENTRYPOINT ["/entrypoint.sh"]
